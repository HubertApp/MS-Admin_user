# Application
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://mongodb:27017/hubertapp_adminusers

# OpenTelemetry — traces vers Grafana Tempo
OTLP_ENDPOINT=http://tempo:4318/v1/traces
OTEL_SERVICE_NAME=ms-admin-user
# Métriques — port scrappé par Prometheus
PROMETHEUS_PORT=9464

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret between API gateway and this service (must match gateway config)
INTERNAL_SECRET=change-me-in-production

# Mongo Express (development only — do not expose in production)
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
