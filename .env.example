# Application
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://mongodb:27017/hubertapp_adminusers

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret between API gateway and this service (must match gateway config)
INTERNAL_SECRET=change-me-in-production

# Mongo Express (development only — do not expose in production)
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
